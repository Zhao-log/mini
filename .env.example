# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会提交。
# 这里只放占位符，任何情况下都不要把真实 Key 写进本文件。

# OpenAI-compatible 接口地址（DashScope 兼容模式 / OpenAI / 本地模型均可）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 你的模型服务密钥（占位符，请替换为你自己的 Key）
LLM_API_KEY=sk-your-api-key-here

# 模型名称，例如 qwen3.8-flash、gpt-4o-mini
LLM_MODEL=qwen3.8-flash
